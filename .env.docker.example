# Personal install. Keep the API on localhost; use an SSH tunnel for remote access.
COACH_BIND_IP=127.0.0.1
COACH_PORT=8827
POSTGRES_DB=coach
POSTGRES_USER=coach
# Replace this local PostgreSQL password. Single quotes preserve literal $ and #.
POSTGRES_PASSWORD='replace-with-a-long-random-local-password'

# local is an explicitly visible offline demonstration, never a real-model claim.
COACH_PROVIDER=local
COACH_API_BASE_URL=
COACH_API_KEY=
COACH_MODEL=
COACH_REASONING_EFFORT=
COACH_TIMEOUT_SECONDS=90
